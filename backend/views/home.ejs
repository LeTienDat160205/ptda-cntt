          // Xem trước hình (background/avatar)
          function previewImage(evt, targetId) {
            const file = evt.target.files?.[0];
            if (!file) return;
            const url = URL.createObjectURL(file);
            const img = document.getElementById(targetId);
            if (img) {
              img.src = url;
            }
          }
